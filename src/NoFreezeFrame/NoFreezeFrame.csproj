<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NoFreezeFrame</AssemblyName>
    <RootNamespace>NoFreezeFrame</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Disable Hollow Knight 1.5.78 global freeze frames.</Description>
    <GamePath Condition="'$(GamePath)' == ''">E:\SteamLibrary\steamapps\common\Hollow Knight</GamePath>
    <ManagedPath>$(GamePath)\hollow_knight_Data\Managed</ManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MMHOOK_Assembly-CSharp">
      <HintPath>$(ManagedPath)\MMHOOK_Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedPath)\MMHOOK_Assembly-CSharp.dll')"
           Text="Modding API not found. Set GamePath to a Hollow Knight 1.5.78 installation with Modding API 74." />
  </Target>
</Project>
